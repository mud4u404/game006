{
  "name": "jianghu-yeyu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "江湖夜雨（暂名）：单机、手机竖屏、全程点按的中文文字武侠游戏",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "vitest run tests/content.test.ts tests/menpai.test.ts",
    "check": "npm run typecheck && npm run test",
    "smoke": "vite build && node scripts/smoke.mjs",
    "ditu-liang": "node scripts/ditu-shot.mjs",
    "luandian": "vite build && node scripts/luandian.mjs",
    "ids": "UPDATE_IDS=1 vitest run tests/ids.test.ts",
    "retune": "RETUNE=1 vitest run tests/retune.test.ts --silent=false",
    "menpai": "MENPAI=1 vitest run tests/menpai.test.ts --silent=false",
    "balance": "BALANCE=1 vitest run tests/balance.test.ts --silent=false",
    "model": "MODEL=1 vitest run tests/model.test.ts --silent=false",
    "zoubian": "ZOUBIAN=1 vitest run tests/zoubian.test.ts --silent=false",
    "xianguang": "XIANGUANG=1 vitest run tests/xianguang.test.ts --disableConsoleIntercept",
    "chaming": "node scripts/chaming.mjs",
    "kongque": "KONGQUE=1 vitest run tests/kongque.test.ts --silent=false"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
