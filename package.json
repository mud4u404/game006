{
  "name": "emberoath",
  "private": true,
  "version": "1.0.0",
  "description": "烬龙誓约 Emberoath — 一款向九十年代经典战棋致敬的原创 SRPG（Three.js，支持 4K 渲染）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "art:ingest": "tsx scripts/ingest-art.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
